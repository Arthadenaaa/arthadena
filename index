<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SportVenue - Booking Instan</title>
    <style>
        /* Menggunakan dasar gaya dari SportVenue */
        body { font-family: 'Segoe UI', sans-serif; margin: 0; color: #1a202c; background: #f7fafc; }
        .container { max-width: 1000px; margin: 0 auto; padding: 20px; }
        
        /* Hero & Search */
        .hero { background: #2b6cb0; color: white; padding: 40px; text-align: center; border-radius: 0 0 20px 20px; }
        .search-box { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: flex; gap: 10px; margin-top: -30px; }
        
        /* Lapangan Grid */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 30px; }
        .card { background: white; border-radius: 10px; padding: 15px; border: 1px solid #e2e8f0; transition: 0.3s; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 15px rgba(0,0,0,0.1); }
        .status-badge { font-size: 0.8rem; padding: 2px 8px; border-radius: 12px; font-weight: bold; }
        .available { background: #c6f6d5; color: #22543d; }
        
        /* Fitur Aktif: Jadwal */
        .time-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin-top: 10px; }
        .slot { font-size: 0.8rem; border: 1px solid #cbd5e0; padding: 5px; text-align: center; border-radius: 4px; cursor: pointer; }
        .slot.selected { background: #2b6cb0; color: white; border-color: #2b6cb0; }
        .slot.booked { background: #edf2f7; color: #a0aec0; cursor: not-allowed; }
    </style>
</head>
<body>

<div class="hero">
    <h1>Booking Lapangan Favoritmu</h1>
    <p>Cari, Pilih Jam, dan Langsung Main!</p>
</div>

<div class="container">
    <!-- Fitur: Filter Aktif -->
    <div class="search-box">
        <select id="filterSport" style="flex:1; padding: 10px; border-radius: 5px; border: 1px solid #ddd;">
            <option value="all">Semua Olahraga</option>
            <option value="Futsal">Futsal</option>
            <option value="Badminton">Badminton</option>
            <option value="Basket">Basket</option>
        </select>
        <input type="date" id="bookingDate" style="flex:1; padding: 10px; border-radius: 5px; border: 1px solid #ddd;">
        <button onclick="filterVenue()" style="background:#2b6cb0; color:white; border:none; padding:10px 20px; border-radius:5px; font-weight:bold; cursor:pointer;">CARI</button>
    </div>

    <div class="grid" id="venueGrid">
        <!-- Card Lapangan (Data dinamis dari JS) -->
    </div>
</div>

<script>
    // Data dummy lapangan
    const venues = [
        { id: 1, name: "Champions Futsal", type: "Futsal", price: "150.000", img: "FUTSAL" },
        { id: 2, name: "Gor Bulutangkis Sehat", type: "Badminton", price: "50.000", img: "BADMINTON" },
        { id: 3, name: "Arena Basket Pro", type: "Basket", price: "200.000", img: "BASKET" }
    ];

    function renderVenues(data) {
        const grid = document.getElementById('venueGrid');
        grid.innerHTML = data.map(v => `
            <div class="card">
                <div style="height:100px; background:#cbd5e0; border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:bold;">${v.img}</div>
                <h3>${v.name} <span class="status-badge available">Tersedia</span></h3>
                <p>Harga: Rp ${v.price}/jam</p>
                <div class="time-slots">
                    <div class="slot" onclick="selectSlot(this)">08:00</div>
                    <div class="slot booked">09:00</div>
                    <div class="slot" onclick="selectSlot(this)">10:00</div>
                    <div class="slot" onclick="selectSlot(this)">16:00</div>
                    <div class="slot" onclick="selectSlot(this)">19:00</div>
                    <div class="slot" onclick="selectSlot(this)">20:00</div>
                </div>
                <button onclick="bookNow('${v.name}')" style="width:100%; margin-top:15px; padding:10px; background:#2b6cb0; color:white; border:none; border-radius:5px; cursor:pointer;">Pesan Sekarang</button>
            </div>
        `).join('');
    }

    function selectSlot(element) {
        if(element.classList.contains('booked')) return;
        element.classList.toggle('selected');
    }

    function filterVenue() {
        const type = document.getElementById('filterSport').value;
        const filtered = type === 'all' ? venues : venues.filter(v => v.type === type);
        renderVenues(filtered);
    }

    function bookNow(name) {
        alert("Konfirmasi pesanan untuk " + name + " telah dikirim ke sistem! Silakan lanjut ke pembayaran.");
    }

    // Load awal
    renderVenues(venues);
</script>

</body>
</html>
